generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model employee {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(128)
  surname      String     @db.VarChar(128)
  salary       Float      @db.Real
  department   Department? @relation(fields: [departmentId], references: [id], onUpdate: Restrict, onDelete: Restrict)
  departmentId Int?
}

model Department {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(128)
  Employee employee[]
}

model Expense {
  id  Int @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title String
  comment String?
  amount Decimal @default(0)
  author User @relation(fields: [authorId], references: [id])
  authorId Int
  receiptFilename String?
  receiptPath    String?
  receipts    Receipt[]  // 👈 New relation to multiple receipts
  archived Boolean @default(false)
  account ExpenseAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountId Int?
  qbExpenseId String? // QuickBooks expense id (legacy)
  qbQbId String? // QuickBooks entity id (Expense or Transfer)
  qbEntityType String? // QuickBooks entity type ("Expense" or "Transfer")
}

model Receipt {
  id         Int      @id @default(autoincrement())
  filename   String
  path       String
  expense    Expense  @relation(fields: [expenseId], references: [id])
  expenseId  Int
}


model ExpenseAccount {
  id  Int @id @default(autoincrement())
  name String
  refundUser User? @relation(fields: [refundUserId], references: [id])
  refundUserId Int?
  expenses Expense[]
}

model User {
  id      Int      @id @default(autoincrement())
  email   String   @unique
  name    String?
  expenses Expense[]
  expenseAccounts ExpenseAccount[]
}

model Migration {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model QuickBooksToken {
  id          Int      @id @default(autoincrement())
  accessToken String   @db.Text
  refreshToken String? @db.Text
  tokenType   String   @default("bearer")
  expiresAt   DateTime
  realmId     String   @unique
  environment String   @default("sandbox") // sandbox or production
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

